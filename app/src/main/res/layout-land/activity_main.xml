<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Normal landscape screen: controls left, list right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

    <!-- Left side containing the feed buttons and road search -->
    <ScrollView
        android:layout_width="220dp"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Application title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Traffic Scotland"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Load Unplanned Events -->
            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unplanned Events" />

            <!-- Load Current Roadworks -->
            <Button
                android:id="@+id/roadworksButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current Roadworks" />


            <!-- Open a Google Map showing traffic locations -->
            <Button
                android:id="@+id/mapButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View Map" />


            <!-- Enter the name of a road to search -->
            <EditText
                android:id="@+id/roadSearchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Road name (e.g. M8)"
                android:inputType="text"
                android:singleLine="true" />

            <!-- Search and Clear buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/searchButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Search" />

                <Button
                    android:id="@+id/clearSearchButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clear" />

            </LinearLayout>

            <!-- Search for situations within a distance of Glasgow centre -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Distance from Glasgow centre (km)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Distance in kilometres entered by the user -->
                <EditText
                    android:id="@+id/distanceInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="numberDecimal"
                    android:hint="Distance in km (e.g. 20)" />

                <!-- Button to search for nearby situations -->
                <Button
                    android:id="@+id/nearbyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Find Nearby" />

            </LinearLayout>


        </LinearLayout>


    </ScrollView>

    <!-- Right side containing the traffic list or details Fragment -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Displays loading messages and result counts -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Choose a traffic feed to load" />

        <!-- Displays downloaded traffic situations -->
        <ListView
            android:id="@+id/trafficListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />


        <!-- End of the right-hand section -->
    </LinearLayout>

        <!-- End of the normal landscape screen -->
    </LinearLayout>

    <!-- Full-screen container for the map or situation details -->
    <FrameLayout
        android:id="@+id/detailsHolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:visibility="gone" />

</FrameLayout>
