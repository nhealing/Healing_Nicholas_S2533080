<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The normal screen containing controls and the ListView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <!-- Main title -->
        <TextView
            android:id="@+id/salutation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Traffic Scotland"
            android:textSize="24sp" />

        <!-- Load incidents -->
        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load Unplanned Events" />

        <!-- Load roadworks -->
        <Button
            android:id="@+id/roadworksButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load Current Roadworks" />

        <!-- Open a Google Map showing traffic locations -->
        <Button
            android:id="@+id/mapButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Map" />

        <!-- Allows the user to search traffic situations by road name -->
        <EditText
            android:id="@+id/roadSearchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter road name (e.g. M8)"
            android:inputType="text"
            android:singleLine="true" />

        <!-- Buttons used to perform and clear a road search -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/searchButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Search" />

            <Button
                android:id="@+id/clearSearchButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear" />

        </LinearLayout>

        <!-- Search for situations within a fixed distance in Glasgow centre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Distance from Glasgow centre (km)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Distance in kilometres entered by the user -->
            <EditText
                android:id="@+id/distanceInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Distance in km (e.g. 20)"
                android:inputType="numberDecimal" />

            <!-- Button to search for nearby situations -->
            <Button
                android:id="@+id/nearbyButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find Nearby" />

        </LinearLayout>


        <!-- Display loading information or number of results -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Choose a traffic feed to load" />


        <!-- Spinning wheel displayed while traffic information is loading -->
        <ProgressBar
            android:id="@+id/loadingSpinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="8dp"
            android:visibility="gone" />


        <!-- Scrollable collection of traffic situations -->
        <ListView
            android:id="@+id/trafficListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    <!-- End of the normal screen -->
    </LinearLayout>

    <!-- Displays the selected details or Google Map over the normal screen -->
    <FrameLayout
        android:id="@+id/detailsHolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:visibility="gone" />

</FrameLayout>
