<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Main title -->
    <TextView
        android:id="@+id/salutation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Traffic Scotland"
        android:textSize="24sp"
        android:padding="12dp" />

    <!-- Load incidents -->
    <Button
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Load Unplanned Events" />

    <!-- Load roadworks -->
    <Button
        android:id="@+id/roadworksButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Load Current Roadworks" />


    <!-- Allows the user to search traffic situations by road name -->
    <EditText
        android:id="@+id/roadSearchInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter road name (e.g. M8)"
        android:inputType="text"
        android:singleLine="true" />

    <!-- Buttons used to perform and clear a road search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/searchButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Search" />

        <Button
            android:id="@+id/clearSearchButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clear" />

    </LinearLayout>


    <!-- Display loading information or number of results -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose a traffic feed to load"
        android:padding="12dp" />

    <!-- Scrollable collection of traffic situations -->
    <ListView
        android:id="@+id/trafficListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- To hold the Fragment which shows the details of a selected traffic situation -->
    <FrameLayout
        android:id="@+id/detailsHolder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

</LinearLayout>